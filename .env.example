# Copy to .env and fill in (or run: make keys). .env is git-ignored - never commit it.

# --- App ---
APP_ENV=local
APP_VERSION=0.1.0

# --- Container registry (GitHub Container Registry) ---
GHCR_USER=your-github-username
GHCR_TOKEN=replace-me

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- SSH key pair (generated by scripts/gen-keys.sh, base64-encoded) ---
SSH_PUBLIC_KEY_B64=
SSH_PRIVATE_KEY_B64=

# --- Ansible target (a VM you own; leave blank to use localhost) ---
ANSIBLE_HOST=localhost
ANSIBLE_USER=ubuntu

# --- Kubernetes (kind cluster created by Terraform) ---
CLUSTER_NAME=devops-platform
